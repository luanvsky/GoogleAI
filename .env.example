# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK / HARNESS PERSONALIZADO (OpenAI Compatible)
# URL Base do seu harness (Ex: https://api.deepseek.com ou http://seu-harness:8000/v1)
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Chave de API do seu harness ou da DeepSeek (se o harness exigir autenticação; opcional se for rede local sem auth)
DEEPSEEK_API_KEY=""
# Lista de modelos disponíveis no seu harness (separados por vírgula; o backend também consulta /models automaticamente)
DEEPSEEK_MODELS="deepseek-chat,deepseek-reasoner,deepseek-coder"

# EXCEL_WEBHOOK_URL: URL do Webhook do Power Automate para salvar no Excel Online.
EXCEL_WEBHOOK_URL="SUA_URL_AQUI"
